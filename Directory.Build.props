<Project>
  <!-- The one version of the Gonogo contract package every project here
       references. An Uplink reaches Gonogo through KspGonogo.Sitrep.Contract and
       nothing else: the assembly a plugin and its contract slice compile against,
       the test support a test project uses, and the codegen twin behind the
       generated client types all come out of that package.

       The package is in vendor/nuget, which nuget.config names as a feed. It is
       packed from the gonogo commit in vendor/gonogo-ref by that repo's
       scripts/vendor-uplinks-reference-set.sh, which also writes this line, and
       its version names the commit so no machine's NuGet cache can serve an older
       pin's bytes under it. Once a release of the package is on nuget.org this
       becomes that release's version and the vendored file goes. -->
  <PropertyGroup>
    <GonogoContractVersion>1.0.0-pin.ga18140198fa6</GonogoContractVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(KspManaged)' == ''">
    <KspManaged>$(MSBuildThisFileDirectory)vendor\ksp-managed</KspManaged>
  </PropertyGroup>
  <!-- The author's own KSP GameData, where the mod this Uplink wraps is installed. -->
  <PropertyGroup Condition="'$(KspGameData)' == ''">
    <KspGameData>$(MSBuildThisFileDirectory)vendor\gamedata</KspGameData>
  </PropertyGroup>
</Project>
