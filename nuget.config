<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- vendor/nuget holds KspGonogo.Sitrep.Contract, Kerbcast.API and
       Kerbcast.API.Testing, at the versions Directory.Build.props pins.
       Everything else comes from nuget.org. -->
  <packageSources>
    <clear />
    <add key="gonogo-vendored" value="vendor/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="gonogo-vendored">
      <package pattern="KspGonogo.Sitrep.Contract" />
      <package pattern="Kerbcast.API" />
      <package pattern="Kerbcast.API.Testing" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
