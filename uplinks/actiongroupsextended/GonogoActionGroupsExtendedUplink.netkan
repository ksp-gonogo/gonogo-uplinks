{
  "spec_version": "v1.34",
  "identifier": "GonogoActionGroupsExtendedUplink",
  "$kref": "#/ckan/github/ksp-gonogo/gonogo-uplinks/asset_match/^GonogoActionGroupsExtendedUplink\\.zip$",
  "x_netkan_github": {
    "prereleases": false
  },
  "x_netkan_version_edit": {
    "find": "^actiongroupsextended-[vV]?(?<version>.+)$",
    "replace": "${version}"
  },
  "name": "Gonogo Action Groups Extended Uplink",
  "abstract": "Sends Action Groups Extended's action groups and their state to the Gonogo dashboard.",
  "author": "jpeps",
  "license": "MIT",
  "release_status": "stable",
  "ksp_version": "1.12",
  "tags": [
    "plugin",
    "telemetry",
    "control"
  ],
  "resources": {
    "homepage": "https://ksp-gonogo.github.io/",
    "repository": "https://github.com/ksp-gonogo/gonogo-uplinks",
    "bugtracker": "https://github.com/ksp-gonogo/gonogo-uplinks/issues"
  },
  "install": [
    {
      "file": "GameData/GonogoActionGroupsExtendedUplink",
      "install_to": "GameData"
    }
  ]
}
