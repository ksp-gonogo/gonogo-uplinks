{
  "spec_version": "v1.34",
  "identifier": "GonogoKerbalismUplink",
  "$kref": "#/ckan/github/ksp-gonogo/gonogo-uplinks/asset_match/^GonogoKerbalismUplink\\.zip$",
  "x_netkan_github": {
    "prereleases": false
  },
  "x_netkan_version_edit": {
    "find": "^kerbalism-[vV]?(?<version>.+)$",
    "replace": "${version}"
  },
  "name": "Gonogo Kerbalism Uplink",
  "abstract": "Kerbalism life support on the Gonogo dashboard, as one ledger of every profile resource.",
  "author": "jpeps",
  "license": "MIT",
  "release_status": "stable",
  "ksp_version": "1.12",
  "tags": [
    "plugin",
    "telemetry",
    "control"
  ],
  "resources": {
    "homepage": "https://ksp-gonogo.github.io/",
    "repository": "https://github.com/ksp-gonogo/gonogo-uplinks",
    "bugtracker": "https://github.com/ksp-gonogo/gonogo-uplinks/issues",
    "manual": "https://github.com/ksp-gonogo/gonogo-uplinks/blob/main/uplinks/kerbalism/README.md"
  },
  "install": [
    {
      "file": "GameData/GonogoKerbalismUplink",
      "install_to": "GameData"
    }
  ]
}
