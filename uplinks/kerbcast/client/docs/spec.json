{
  "specVersion": 1,
  "uplink": {
    "id": "kerbcast",
    "name": "Kerbcast",
    "version": "1.0.0-rc.7",
    "description": "Live in-flight camera views from Hullcam VDS parts, with aim and zoom controls, streamed by kerbcast.",
    "wraps": {
      "name": "kerbcast",
      "builtAgainst": "1.12.0-rc.2",
      "tier": "ckan"
    }
  },
  "topics": [
    {
      "id": "kerbcast.available",
      "array": false,
      "fields": [],
      "disposition": {
        "delivery": "lossy-latest",
        "delay": "true-now"
      }
    },
    {
      "id": "kerbcast.cameras",
      "payload": "KerbcastCameraEntry",
      "array": true,
      "fields": [
        {
          "name": "cameraId",
          "unit": "id"
        },
        {
          "name": "cameraName",
          "unit": "text"
        },
        {
          "name": "dockingPortNodeType",
          "unit": "text"
        },
        {
          "name": "dockingPortState",
          "unit": "text"
        },
        {
          "name": "fieldOfView",
          "unit": "°"
        },
        {
          "name": "fieldOfViewMaximum",
          "unit": "°"
        },
        {
          "name": "fieldOfViewMinimum",
          "unit": "°"
        },
        {
          "name": "isDockingCamera",
          "unit": "flag"
        },
        {
          "name": "panPitch",
          "unit": "°"
        },
        {
          "name": "panPitchMaximum",
          "unit": "°"
        },
        {
          "name": "panPitchMinimum",
          "unit": "°"
        },
        {
          "name": "panYaw",
          "unit": "°"
        },
        {
          "name": "panYawMaximum",
          "unit": "°"
        },
        {
          "name": "panYawMinimum",
          "unit": "°"
        },
        {
          "name": "partId",
          "unit": "id"
        },
        {
          "name": "partName",
          "unit": "text"
        },
        {
          "name": "partTitle",
          "unit": "text"
        },
        {
          "name": "supportsPan",
          "unit": "flag"
        },
        {
          "name": "supportsZoom",
          "unit": "flag"
        },
        {
          "name": "vesselId",
          "unit": "id"
        }
      ],
      "disposition": {
        "delivery": "lossy-latest",
        "delay": "delayed"
      }
    }
  ],
  "nestedPayloads": [],
  "otherPayloads": [],
  "commands": [
    {
      "id": "kerbcast.setFieldOfView",
      "args": "KerbcastSetFieldOfViewArgs",
      "result": "CommandResult"
    },
    {
      "id": "kerbcast.setPan",
      "args": "KerbcastSetPanArgs",
      "result": "CommandResult"
    }
  ],
  "commandArgs": [
    {
      "name": "KerbcastSetFieldOfViewArgs",
      "fields": [
        {
          "name": "cameraId",
          "unit": "id"
        },
        {
          "name": "fieldOfView",
          "unit": "°"
        },
        {
          "name": "lensKey",
          "unit": "text"
        }
      ]
    },
    {
      "name": "KerbcastSetPanArgs",
      "fields": [
        {
          "name": "cameraId",
          "unit": "id"
        },
        {
          "name": "lensKey",
          "unit": "text"
        },
        {
          "name": "pitch",
          "unit": "°"
        },
        {
          "name": "yaw",
          "unit": "°"
        }
      ]
    }
  ],
  "widgets": [
    {
      "id": "camera-feed",
      "name": "Camera Feed",
      "description": "A live view from a camera on the active craft. Pick which camera to watch, step to the next or previous one, and aim and zoom the ones that can.",
      "tags": [
        "camera"
      ],
      "channels": [],
      "optionalChannels": [],
      "commands": [],
      "channelFamilies": [],
      "optionalChannelFamilies": [],
      "readsFromConfig": false,
      "dataRequirements": [
        "vessel.comms",
        "comms.link",
        "comms.delay"
      ],
      "fields": [],
      "actions": [
        {
          "id": "next-camera",
          "label": "Next camera",
          "description": "Switch to the next available camera, persisting the choice to the widget config (wraps round at the end of the list)."
        },
        {
          "id": "prev-camera",
          "label": "Previous camera",
          "description": "Switch to the previous available camera (wraps round)."
        },
        {
          "id": "zoom-in",
          "label": "Zoom in",
          "description": "Held: zooms in, field of view falling. Live, this drives the camera; above the staged delay threshold it turns the staged zoom wheel at 30 degrees per second and sends nothing until the commit."
        },
        {
          "id": "zoom-out",
          "label": "Zoom out",
          "description": "Held: zooms out, field of view rising. Live, this drives the camera; above the staged delay threshold it turns the staged zoom wheel at 30 degrees per second and sends nothing until the commit."
        },
        {
          "id": "pan-yaw",
          "label": "Pan yaw axis",
          "description": "Analog yaw rate, -1..1. Positive = right. Live, this is the camera's pan rate at up to its max pan speed; above the staged delay threshold it turns the staged yaw wheel at up to 30 degrees per second, clamped to the camera's yaw envelope, and sends nothing until the commit."
        },
        {
          "id": "pan-pitch",
          "label": "Pan pitch axis",
          "description": "Analog pitch rate, -1..1. Positive = up. Live, this is the camera's pan rate at up to its max pan speed; above the staged delay threshold it turns the staged pitch wheel at up to 30 degrees per second, clamped to the camera's pitch envelope, and sends nothing until the commit. A camera with no pitch envelope does not move either way."
        }
      ],
      "augmentSlots": [
        "camera-feed.overlay"
      ],
      "contributionSlots": [],
      "requires": [],
      "replaces": null,
      "pushable": true,
      "defaultSize": {
        "w": 9,
        "h": 8
      },
      "minSize": {
        "w": 7,
        "h": 6
      },
      "tiny": false
    }
  ],
  "augments": [
    {
      "id": "kerbcast-crew-avatar",
      "augments": "crew-status.avatar",
      "channels": [],
      "requires": "kerbcast",
      "suppressesVanillaBase": false,
      "settings": []
    },
    {
      "id": "kerbcast-docking-camera",
      "augments": "rendezvous.camera",
      "channels": [
        "kerbcast.cameras"
      ],
      "requires": "kerbcast",
      "suppressesVanillaBase": false,
      "settings": []
    }
  ],
  "contributions": [],
  "models": {
    "processors": [],
