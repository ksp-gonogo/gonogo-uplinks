<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Compile only the PURE, KSP-free files from the uplink so the tests never
       need the KSP assemblies (same selective-Compile pattern
       GonogoRealAntennasUplink.Tests and GonogoScansatUplink.Tests use).

       KerbcastHealth is the mandatory-healthcheck state machine;
       KerbcastCameraEntryBuilder is the clean-name wire mapping;
       IKerbcastApi is what this Uplink asks of kerbcast, and KerbcastBinding is how
       it binds (names no KSP or kerbcast type, so a fake stands in for kerbcast);
       SidecarDeathDebouncer is the sidecar-liveness debounce state machine
       Health() reads through KerbcastUplink;
       KerbcastAimOutcome is what kerbcast's answer to an aim command means on
       the wire.

       DockingCameraDetector and KerbcastUplink are deliberately ABSENT: both
       touch live stock-KSP types (Part/ModuleDockingNode/FlightGlobals) and so
       cannot compile headless. Their pure logic was extracted into the files
       above precisely so it could be tested. -->
  <ItemGroup>
    <Compile Include="..\mod\KerbcastHealth.cs" />
    <Compile Include="..\mod\KerbcastCameraEntryBuilder.cs" />
    <Compile Include="..\mod\IKerbcastApi.cs" />
    <Compile Include="..\mod\DockingCameraFacts.cs" />
    <Compile Include="..\mod\SidecarDeathDebouncer.cs" />
    <Compile Include="..\mod\KerbcastAimOutcome.cs" />
    <Compile Include="..\mod\KerbcastModSettings.cs" />
    <!-- The manifest, so CommandSubjectTests can check what it declares. -->
    <Compile Include="..\mod\KerbcastManifest.cs" />
    <!-- Generated by `uplink-tools bake`; referenced by the manifest above. -->
    <Compile Include="..\mod\Provenance.g.cs" />
    <Compile Include="..\mod\ClientSource.g.cs" />
    <Compile Include="..\mod\ExpectedClientHash.g.cs" />
  </ItemGroup>

  <!-- GonogoKerbcastUplink.Contract: KerbcastCameraEntry/KerbcastSetFieldOfViewArgs/
       KerbcastSetPanArgs, this Uplink's own wire types (relocated out of
       Sitrep.Contract, see that project's header comment).
       KerbcastUnitCoverageTests.cs below reflects over it directly. -->
  <ItemGroup>
    <ProjectReference Include="..\mod-contract\GonogoKerbcastUplink.Contract.csproj" />
    <!-- Sitrep.Contract.TestSupport: the shared Unit-coverage sweep every
         relocated Uplink's <X>UnitCoverageTests calls, extracted once five
         near-identical copies existed (see UnitCoverageAssertion's own doc
         comment). The [Fact]s stay here, naming this Uplink's own types. -->
    <!-- KerbcastHealth builds Sitrep.Contract's UplinkHealth (KSP-free). -->
    <PackageReference Include="KspGonogo.Sitrep.Contract" Version="[$(GonogoContractVersion)]" />
  </ItemGroup>

</Project>
