<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GonogoKerbcastUplink</AssemblyName>
    <RootNamespace>Gonogo.KerbcastUplink</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- KSP / Unity reference assemblies: same portable copy + Private="false"
       pattern as GonogoRealAntennasUplink. Stock KSP's Part / ModuleDockingNode
       / FlightGlobals are stock KSP, so they are normal references, and so is
       Kerbcast (below). Reading ModuleDockingNode off a stock Part is what
       lets this uplink answer "which cameras are docking cameras" without
       kerbcast knowing anything about docking at all. -->
  <ItemGroup>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- kerbcast's own assembly, compiled against so a rename in kerbcast fails
       this build rather than a running game. Private="false": kerbcast is
       installed beside this Uplink, never bundled with it. Only
       KerbcastControlApi names its types, and it is constructed only after the
       assembly is known to be loaded (see KerbcastBinding). -->
  <ItemGroup>
    <Reference Include="Kerbcast" Private="false">
      <HintPath>$(KspGameData)\Kerbcast\Plugins\Kerbcast.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Sitrep.Contract ONLY of core's assemblies (Private="false"): the
       arm's-length compile surface a third-party uplink needs. -->
  <ItemGroup>
    <Reference Include="Sitrep.Contract" Private="false">
      <HintPath>$(GonogoContract)\net472\Sitrep.Contract.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- GonogoKerbcastUplink.Contract: this Uplink's OWN wire types
       (KerbcastCameraEntry, KerbcastSetFieldOfViewArgs, KerbcastSetPanArgs),
       relocated out of Sitrep.Contract (see that project's own header
       comment). Private defaults to true (unlike the Sitrep.Contract
       reference above): this DLL is NOT provided by core at runtime, it is
       this Uplink's own contract slice, so it bundles into
       GonogoKerbcastUplink's own GameData output same as any other
       Uplink-owned assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\mod-contract\GonogoKerbcastUplink.Contract.csproj" />
  </ItemGroup>

</Project>
