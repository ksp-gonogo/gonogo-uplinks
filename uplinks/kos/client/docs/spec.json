      "array": true,
      "fields": [
        {
          "name": "bootFilePath",
          "unit": "text"
        },
        {
          "name": "coreId",
          "unit": "id"
        },
        {
          "name": "hasBooted",
          "unit": "flag"
        },
        {
          "name": "partName",
          "unit": "text"
        },
        {
