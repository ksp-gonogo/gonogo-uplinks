  "errorCodes": [
    {
      "id": "kos.cpuBusy",
      "refines": "notClearToProceed",
      "sentence": "the CPU is busy and not at its prompt",
      "meaning": "The CPU is booting, running a program, or already running a script for another request, so it is not at a prompt that can take one."
    },
    {
      "id": "kos.noTerminal",
      "refines": "capabilityMismatch",
      "sentence": "that CPU has no terminal window to type into",
      "meaning": "The CPU has no terminal window a script could be typed into."
    },
    {
      "id": "kos.terminalHeld",
      "refines": "notClearToProceed",
      "sentence": "another screen is using this CPU's terminal",
      "meaning": "Another screen holds this CPU's terminal. A terminal is leased to one screen at a time and never taken from it; it frees when that screen closes it."
    }
  ]
