<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- GonogoMechJebUplink.Contract: MechJebAscentArgs/MechJebNoArgs, this
         Uplink's own wire types. MechJebChannels.cs/MechJebUplink.cs below
         reference them directly. -->
    <ProjectReference Include="..\mod-contract\GonogoMechJebUplink.Contract.csproj" />
    <!-- Sitrep.Contract.TestSupport: the shared Unit-coverage sweep every
         Uplink's <X>UnitCoverageTests calls. The [Fact]s stay here, naming
         this Uplink's own types. -->
    <Reference Include="Sitrep.Contract.TestSupport">
      <HintPath>$(GonogoDevkit)\Sitrep.Contract.TestSupport.dll</HintPath>
    </Reference>
    <!-- Sitrep.Contract is the pure-DTO/SPI assembly MechJebUplink's
         MechJeb2-free half compiles against (UplinkManifest, ISitrepUplink,
         IUplinkHost, CommandResult, ...): no KSP/Unity/MechJeb2 linkage. -->
    <Reference Include="Sitrep.Contract">
      <HintPath>$(GonogoContract)\netstandard2.0\Sitrep.Contract.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Only the KSP/Unity/MechJeb2-type-free half of GonogoMechJebUplink is
         exercised here: net10.0, no MechJeb2.dll/UnityEngine.dll reference
         assemblies needed. MechJebUplink.cs is split into a MechJeb2-free half
         (this file) and a MechJeb2-touching half (MechJebUplink.Ksp.cs, NOT
         included below) via `partial class`, see MechJebUplink.cs's class doc
         comment for the seam (InstallProductionDefaults). MechJebController.cs
         (touches MuMech/UnityEngine/Assembly-CSharp types) and
         MechJebMainThreadDispatcherAddon.cs (touches UnityEngine/GameObject)
         are deliberately NOT included: nothing this project needs reaches
         them. -->
    <Compile Include="..\mod\MechJebChannels.cs" />
    <Compile Include="..\mod\MechJebVersionGuard.cs" />
    <Compile Include="..\mod\MechJebAscentGuard.cs" />
    <Compile Include="..\mod\MainThreadDispatcher.cs" />
    <Compile Include="..\mod\MechJebUplink.cs" />
    <Compile Include="..\mod\ExpectedClientHash.g.cs" />
  </ItemGroup>
</Project>
