{
  "spec_version": "v1.34",
  "identifier": "GonogoPrincipiaUplink",
  "$kref": "#/ckan/github/ksp-gonogo/gonogo-uplinks/asset_match/^GonogoPrincipiaUplink\\.zip$",
  "x_netkan_github": {
    "prereleases": false
  },
  "x_netkan_version_edit": {
    "find": "^principia-[vV]?(?<version>.+)$",
    "replace": "${version}"
  },
  "name": "Gonogo Principia Uplink",
  "abstract": "Principia's n-body flight on the Gonogo dashboard: trajectory reliability, the flight plan and its manoeuvres.",
  "author": "jpeps",
  "license": "MIT",
  "release_status": "stable",
  "ksp_version": "1.12",
  "tags": [
    "plugin",
    "telemetry",
    "control"
  ],
  "resources": {
    "homepage": "https://ksp-gonogo.github.io/",
    "repository": "https://github.com/ksp-gonogo/gonogo-uplinks",
    "bugtracker": "https://github.com/ksp-gonogo/gonogo-uplinks/issues",
    "manual": "https://github.com/ksp-gonogo/gonogo-uplinks/blob/main/uplinks/principia/README.md"
  },
  "install": [
    {
      "file": "GameData/GonogoPrincipiaUplink",
      "install_to": "GameData"
    }
  ]
}
