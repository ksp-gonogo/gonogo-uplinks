<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Every file of this uplink EXCEPT the one that reaches the game compiles
       here, which is the point of it. The guard needs only System.Reflection;
       the observation, the builder and the reflection walk need nothing but the
       framework; the uplink needs Sitrep.Contract for ISitrepUplink.

       PrincipiaUplink.Observer.cs, PrincipiaSettingsSource.cs,
       PrincipiaGravityModelSource.cs, PrincipiaPerturbers.cs and
       PrincipiaSession.Live.cs are deliberately ABSENT. They are the only files
       naming a KSP or Harmony type, and both PrincipiaUplink and PrincipiaSession
       are partial precisely so that omitting them still compiles: the AttachObserver,
       AttachGravityModel and AttachPerturbers partial method calls disappear and the
       publish rule is driven by a fake observer instead, and the sourcing protocol
       runs against a fake plugin with no way to find a real one. Adding any of them
       here would trade that coverage for a reference this project does not need.

       The horizon splits the same way. PrincipiaPerturbers is the body-tree walk
       and is absent; PrincipiaHorizonBound is the arithmetic and the rig-measured
       constants and is here, driven against the masses and distances the live save
       actually had.

       The gravity model splits the same way and for the same reason. The GameDatabase
       walk and the star's-own-tree walk are in PrincipiaGravityModelSource and are
       absent; every decision about what a config value means, and which of the two
       sources wins, is in GravityModelParser and is here, driven against the shipped
       file's own spellings.

       PrincipiaPropagationProvider is here in full: winning the propagation
       capability is the one registration this Uplink makes that decides whether any
       craft's trajectory is published as integrated, and it names no game type at
       all, so the election it takes part in is drivable against a real kernel with
       no game running.

       Note how little the settings work left in the game-facing file: finding
       the addon, the game's body table, and the game's own target. Every read,
       every match and every publish decision is in the four files above it and is
       driven here by doubles that carry the producer's member names.

       The sourcing layer is here in full apart from that one file, which is what
       makes the precondition protocol testable at all: the whole of it (the
       version gate, the frame, the gates, the cursors and the refusal register)
       needs nothing but the framework.

       Selective Compile, the pattern the sibling uplink Tests projects use. -->
  <ItemGroup>
    <Compile Include="..\mod\PrincipiaControlFrameSource.cs" />
    <Compile Include="..\mod\PrincipiaManeuverPlanSource.cs" />
    <Compile Include="..\mod\PrincipiaVersionGuard.cs" />
    <Compile Include="..\mod\PrincipiaBinaryVocabulary.cs" />
    <Compile Include="..\mod\PrincipiaBinaryHealth.cs" />
    <Compile Include="..\mod\PrincipiaBinaryDiscovery.cs" />
    <Compile Include="..\mod\PrincipiaDescriptorReader.cs" />
    <Compile Include="..\mod\PrincipiaSupportedSet.cs" />
    <Compile Include="..\mod\PrincipiaConformanceGate.cs" />
    <Compile Include="..\mod\PrincipiaComposedPlanRules.cs" />
    <Compile Include="..\mod\PrincipiaWorkerHost.cs" />
    <Compile Include="..\mod\MappedModules.cs" />
    <Compile Include="..\mod\PrincipiaWorkerProcess.cs" />
    <Compile Include="..\mod\NativeExportReader.cs" />
    <Compile Include="..\mod\PrincipiaSymbolGate.cs" />
    <Compile Include="..\mod\PrincipiaUplink.cs" />
    <Compile Include="..\mod\ReflectedMembers.cs" />
    <Compile Include="..\mod\ISettingsSource.cs" />
    <Compile Include="..\mod\SettingsObservation.cs" />
    <Compile Include="..\mod\SettingsReflection.cs" />
    <Compile Include="..\mod\NativeSettingsReader.cs" />
    <Compile Include="..\mod\SettingsBuilder.cs" />
    <Compile Include="..\mod\PrincipiaCalls.cs" />
    <Compile Include="..\mod\IPrincipiaPlugin.cs" />
    <Compile Include="..\mod\PrincipiaSession.cs" />
    <Compile Include="..\mod\PrincipiaFrame.cs" />
    <Compile Include="..\mod\ReflectedPrincipiaPlugin.cs" />
    <Compile Include="..\mod\GravityModelParser.cs" />
    <Compile Include="..\mod\PrincipiaPropagationProvider.cs" />
    <Compile Include="..\mod\PrincipiaHorizonBound.cs" />

    <!-- The write surface, all of it. Not one line of it needs the game: the
         register, the authority, the gates, the burn and integrator rules, the
         round-trip probe, the plan reader, the mapper and the nine command
         handlers are reached through the same two seams the read side uses, so
         every guard between a console control and the player's save is drivable
         against a double that carries the producer's own field names. That is the
         property to preserve: a guard that can only be exercised in a running KSP
         is a guard nobody exercises. -->
    <Compile Include="..\mod\PrincipiaWriteCalls.cs" />
    <Compile Include="..\mod\PrincipiaWriteAuthority.cs" />
    <Compile Include="..\mod\PrincipiaBurnStruct.cs" />
    <Compile Include="..\mod\PrincipiaBurnRules.cs" />
    <Compile Include="..\mod\PrincipiaBurnComposer.cs" />
    <Compile Include="..\mod\PrincipiaComposedFrame.cs" />
    <Compile Include="..\mod\PrincipiaPlanWrite.cs" />
    <Compile Include="..\mod\PrincipiaLayoutProbe.cs" />
    <Compile Include="..\mod\PlanObservation.cs" />
    <Compile Include="..\mod\PlanReader.cs" />
    <Compile Include="..\mod\PlanBuilder.cs" />
    <Compile Include="..\mod\AnalysisObservation.cs" />
    <Compile Include="..\mod\AnalysisReader.cs" />
    <Compile Include="..\mod\AnalysisBuilder.cs" />
    <Compile Include="..\mod\PlanCommands.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Sitrep.Contract">
      <HintPath>$(GonogoContract)\netstandard2.0\Sitrep.Contract.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\mod-contract\GonogoPrincipiaUplink.Contract.csproj" />
  </ItemGroup>

</Project>
