<Project Sdk="Microsoft.NET.Sdk">

  <!-- MIT, like the rest of gonogo (see LICENSING.md).

       This assembly NEVER references any Principia assembly. It DOES now bind
       Principia members by reflection, which the earlier detection-only version
       did not, and the distinction that makes it safe is worth stating: every
       member it reads is managed, and each one was read in the decompiled body
       and confirmed to touch no plugin. Principia's native surface aborts the KSP
       process on a bad call, but that guard is armed against the ARGUMENTS a
       caller passes it, and a field read passes none. The one property on the
       burn editor that does cross the ABI is named and excluded in
       ReflectedMembers' doc comment. -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GonogoPrincipiaUplink</AssemblyName>
    <RootNamespace>GonogoPrincipiaUplink</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- KSP + Harmony, and the reason is recorded rather than the references left
       to look speculative. It is this:

       - Debug, because a warning written to Console.Error from inside the host is
         invisible in the game's log.
       - 0Harmony, for AccessTools.TypeByName ONLY. This Uplink patches nothing.
         It used to: two observe-only postfixes on the producer's planner render
         fed a channel that mirrored that window, and they went with it, because a
         channel that answers only while the player has a panel open is not a
         channel. Nothing here may add a patch back without a better reason than
         that one turned out to be.

       The property worth preserving is that the PURE half stays reference-free:
       the observation types, the readers and the builders touch no KSP or Harmony
       type, so the payload logic and the reflection walks are tested headless.
       Keep it that way: logic that migrates into a game-facing file stops being
       testable. -->
  <!-- KSP / Unity reference assemblies, rooted at $(KspManaged) from the
       repository's Directory.Build.props. Private=false: never copied to
       output; KSP's own KSP_Data/Managed satisfies the load at runtime. -->
  <ItemGroup>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- 0Harmony, for AccessTools.TypeByName ONLY (this Uplink patches nothing).
       $(KspGameData) is the author's own installed GameData tree, rooted at
       the repository's Directory.Build.props. -->
  <ItemGroup>
    <Reference Include="0Harmony" Private="false">
      <HintPath>$(KspGameData)\000_Harmony\0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Sitrep.Contract only, Private="false": provided by the core mod at
       runtime, never copied here. GonogoPrincipiaUplink.Contract is this
       Uplink's OWN wire payload slice and bundles into its own output. -->
  <ItemGroup>
    <Reference Include="Sitrep.Contract" Private="false">
      <HintPath>$(GonogoContract)\net472\Sitrep.Contract.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\mod-contract\GonogoPrincipiaUplink.Contract.csproj" />
  </ItemGroup>

</Project>
