<Project Sdk="Microsoft.NET.Sdk">

  <!-- MIT, like the rest of gonogo (see LICENSING.md). RealAntennas is
       CC-BY-SA-4.0 (comms-uplink-design.md §4.1), a CONTENT licence whose
       ShareAlike could reach a COMBINED work. This uplink therefore NEVER
       links RA's assembly and NEVER derives from its types, it reaches every
       RA member by runtime reflection (RaReflection), the RemoteTech-style
       arm's-length pattern (§4.2). That arm's-length boundary is what keeps
       this assembly clear of ShareAlike, and it holds under MIT exactly as it
       did under GPL. RA's attribution notice is retained in
       NOTICE-REALANTENNAS.txt alongside this file. -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GonogoRealAntennasUplink</AssemblyName>
    <RootNamespace>Gonogo.RealAntennasUplink</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- KSP / Unity reference assemblies, rooted at $(KspManaged) from the
       repository's Directory.Build.props. Private=false: never copied to
       output; KSP's own KSP_Data/Managed satisfies the load at runtime. Stock
       CommNet (CommNetVessel/CommPath/CommNode) is stock KSP, so it is a
       normal reference; only the RealAntennas assembly is forbidden as a
       compile-time reference (reached by reflection instead). -->
  <ItemGroup>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Sitrep.Contract only, Private="false": provided by the core mod at
       runtime, never copied here. NOTE: no reference to RealAntennas.dll, by
       design (§4.2). GonogoRealAntennasUplink.Contract is this Uplink's OWN
       wire payload slice and bundles into its own output. -->
  <ItemGroup>
    <Reference Include="Sitrep.Contract" Private="false">
      <HintPath>$(GonogoContract)\net472\Sitrep.Contract.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\mod-contract\GonogoRealAntennasUplink.Contract.csproj" />
  </ItemGroup>

</Project>
