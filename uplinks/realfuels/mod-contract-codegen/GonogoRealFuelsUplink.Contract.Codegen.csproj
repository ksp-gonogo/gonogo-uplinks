<Project Sdk="Microsoft.NET.Sdk">
  <!-- Codegen-only twin of GonogoRealFuelsUplink.Contract. See CodegenTwin.props. -->
  <PropertyGroup>
    <CodegenTwinSource>..\mod-contract</CodegenTwinSource>
    <AssemblyName>GonogoRealFuelsUplink.Contract</AssemblyName>
    <RootNamespace>GonogoRealFuelsUplink</RootNamespace>
    <TargetFramework Condition="'$(GonogoCodegen)' == ''">netstandard2.0</TargetFramework>
  </PropertyGroup>
  <Import Project="$(GonogoCodegen)\CodegenTwin.props" Condition="'$(GonogoCodegen)' != ''" />
  <!-- The Sitrep.Contract TWIN, not the shipped contract: rtcli reads this
       assembly's metadata and resolves the core types it references, and it
       must see the same core assembly it always did, attributes included.
       The twin's AssemblyName is Sitrep.Contract, so identity is unchanged.
       Copied local (unlike the shipped slice's Private="false" reference)
       so rtcli finds it beside the assembly it is loading, which is what
       codegen.sh used to hand-copy. -->
  <ItemGroup>
    <Reference Include="Sitrep.Contract">
      <HintPath>$(GonogoCodegen)\Sitrep.Contract.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- Built only by `uplink-tools codegen`, which passes GonogoCodegen: the codegen
       folder of the KspGonogo.Sitrep.Contract package the contract slice restored. -->
  <Target Name="RequireCodegenCommand" BeforeTargets="CoreCompile" Condition="'$(GonogoCodegen)' == ''">
    <Error Text="This project is the contract slice's codegen twin, and only one command builds it: npx uplink-tools codegen" />
  </Target>
</Project>
