<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The WHOLE uplink compiles here, reflection layer included, because none of
       it references KSP or Unity: everything it reads is RP-1's own state
       reached by reflection. So the graph walk is exercised headless against the
       stand-in RP-1 types in Rp0Fixture.cs rather than being the one part that
       only a live game could test. -->
  <ItemGroup>
    <Compile Include="..\mod\Rp1Types.cs" />
    <Compile Include="..\mod\Rp1ScRaw.cs" />
    <Compile Include="..\mod\Rp1ScMath.cs" />
    <Compile Include="..\mod\Rp1ScCapture.cs" />
    <Compile Include="..\mod\Rp1ScReflection.cs" />
    <Compile Include="..\mod\Rp1FacilitiesReflection.cs" />
    <Compile Include="..\mod\Rp1ProgramsRaw.cs" />
    <Compile Include="..\mod\Rp1ProgramsMath.cs" />
    <Compile Include="..\mod\Rp1ProgramsCapture.cs" />
    <Compile Include="..\mod\Rp1ProgramsReflection.cs" />
    <Compile Include="..\mod\Rp1CrewRaw.cs" />
    <Compile Include="..\mod\Rp1CrewMath.cs" />
    <Compile Include="..\mod\Rp1CrewCapture.cs" />
    <Compile Include="..\mod\Rp1CrewReflection.cs" />
    <Compile Include="..\mod\Rp1CrewStandingBackend.cs" />
    <Compile Include="..\mod\Rp1TrainingCatalogueReflection.cs" />
    <Compile Include="..\mod\Rp1TrainingCommands.cs" />
    <Compile Include="..\mod\Rp1ToolingRaw.cs" />
    <Compile Include="..\mod\Rp1ToolingCapture.cs" />
    <Compile Include="..\mod\Rp1ToolingReflection.cs" />
    <Compile Include="..\mod\Rp1ToolingCommands.cs" />
    <Compile Include="..\mod\Rp1CareerCostRaw.cs" />
    <Compile Include="..\mod\Rp1CareerCostCapture.cs" />
    <Compile Include="..\mod\Rp1CareerCostReflection.cs" />
    <Compile Include="..\mod\Rp1AvionicsRaw.cs" />
    <Compile Include="..\mod\Rp1AvionicsCapture.cs" />
    <Compile Include="..\mod\Rp1AvionicsReflection.cs" />
    <Compile Include="..\mod\Rp1ScUplink.cs" />
    <Compile Include="..\mod\Rp1EconomyBackend.cs" />
    <Compile Include="..\mod\Rp1EconomyUpkeepQuery.cs" />
    <Compile Include="..\mod\Rp1LaunchGate.cs" />
    <Compile Include="..\mod\Rp1CareerProjectGate.cs" />
    <Compile Include="..\mod\Rp1Envelope.cs" />
    <Compile Include="..\mod\Rp1Buildable.cs" />
    <Compile Include="..\mod\Rp1Pricing.cs" />
    <Compile Include="..\mod\Rp1BuildCommands.cs" />
    <Compile Include="..\mod\Rp1BuildStartCommands.cs" />
    <Compile Include="..\mod\Rp1VehicleCommands.cs" />
    <Compile Include="..\mod\Rp1ComplexWrites.cs" />
    <Compile Include="..\mod\Rp1LcCostModel.cs" />
    <Compile Include="..\mod\Rp1ComplexLifecycleCommands.cs" />
    <Compile Include="..\mod\Rp1ComplexConstructionCommands.cs" />
    <Compile Include="..\mod\Rp1WarpCommands.cs" />
    <Compile Include="..\mod\Rp1ContractCommands.cs" />
    <Compile Include="..\mod\Rp1PersonnelCommands.cs" />
    <Compile Include="..\mod\Rp1StrategyWrites.cs" />
    <Compile Include="..\mod\Rp1StrategyCommands.cs" />
    <Compile Include="..\mod\Rp1TargetCommands.cs" />
    <Compile Include="..\mod\Rp1FacilityUpgradeCommands.cs" />
    <Compile Include="..\mod\Rp1ResearchCommands.cs" />
