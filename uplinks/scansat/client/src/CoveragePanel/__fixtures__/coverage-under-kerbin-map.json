{
  "_meta": {
    "notes": "SYNTHETIC. The coverage figures are the Scanning scene's; Resource Lo is added at 18.2 % so every row the panel draws has a figure. ScanSat-1 carries an Alt Hi scanner at its best altitude and a Biome scanner in range."
  },
  "_scene": {
    "augment": "scansat-coverage-panel",
    "hostWidget": "map-view",
    "modes": [
      "default"
    ],
    "hero": true,
    "caption": "Map View over Kerbin with SCANsat's per-scan-type coverage rows beneath the map, and which types a satellite is scanning right now",
    "paints": [
      "Alt Hi",
      "Biome"
    ]
  },
