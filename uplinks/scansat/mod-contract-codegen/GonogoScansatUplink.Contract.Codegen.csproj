<Project Sdk="Microsoft.NET.Sdk">
  <!-- Codegen-only twin of GonogoScansatUplink.Contract. See ..\CodegenTwin.props. -->
  <PropertyGroup>
    <CodegenTwinSource>..\mod-contract</CodegenTwinSource>
    <AssemblyName>GonogoScansatUplink.Contract</AssemblyName>
    <RootNamespace>GonogoScansatUplink</RootNamespace>
  </PropertyGroup>
  <Import Project="$(GonogoContract)\CodegenTwin.props" />
  <!-- The Sitrep.Contract TWIN, not the shipped contract: rtcli reads this
       assembly's metadata and resolves the core types it references, and it
       must see the same core assembly it always did, attributes included.
       The twin's AssemblyName is Sitrep.Contract, so identity is unchanged.
       Copied local (unlike the shipped slice's Private="false" reference)
       so rtcli finds it beside the assembly it is loading, which is what
       codegen.sh used to hand-copy. -->
  <ItemGroup>
    <Reference Include="Sitrep.Contract">
      <HintPath>$(GonogoContract)\codegen\Sitrep.Contract.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
